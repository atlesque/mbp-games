{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "mbp-games",
  "main": "src/index.js",
  "compatibility_date": "2026-09-01",
  "routes": [{ "pattern": "accounts.atlesque.dev", "custom_domain": true }],
  "workers_dev": false,
  // pages in public/ (sign-in, account hub, admin); the Worker answers /api/* and /auth/* first
  "assets": { "directory": "./public", "binding": "ASSETS", "html_handling": "drop-trailing-slash", "run_worker_first": ["/api/*", "/auth/*"] },
  "d1_databases": [{ "binding": "DB", "database_name": "mbp-games", "database_id": "53322094-f149-4ba2-874c-4eedd9419c66", "migrations_dir": "migrations" }],
  "send_email": [{ "name": "EMAIL", "allowed_sender_addresses": ["noreply@atlesque.dev"] }],
  "vars": { "MAIL_FROM": "noreply@atlesque.dev", "MAIL_FROM_NAME": "MBP Games" },
  // ADMIN_EMAILS (comma-separated) is a secret set in the dashboard, so it isn't in the repo
  "keep_vars": true,
  "triggers": { "crons": ["17 3 * * *"] },
  "observability": { "enabled": true },
  // Worker Previews (PR branch builds) use their own empty database, never the live accounts.
  // New migrations: npx wrangler d1 migrations apply mbp-games-preview --remote --config wrangler.preview-migrations.jsonc
  "previews": {
    "vars": { "MAIL_FROM": "noreply@atlesque.dev", "MAIL_FROM_NAME": "MBP Games (preview)" },
    "d1_databases": [{ "binding": "DB", "database_name": "mbp-games-preview", "database_id": "a8b30968-5ab2-4c3e-b47b-b17105738936" }],
    "send_email": [{ "name": "EMAIL", "allowed_sender_addresses": ["noreply@atlesque.dev"] }]
  }
}
